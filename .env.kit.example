# Only configure explicitly selected live adapters. No credentials needed for local mode.
# optional; non-secret; Set true only after configuring the Python OCR worker.
KIT_OCR_ENABLED=
# optional; non-secret; Absolute server-side Python executable path with OCR extra installed.
KIT_OCR_PYTHON=
# optional; non-secret; Absolute path to starters/python/app/ocr_worker.py.
KIT_OCR_WORKER=
# live; non-secret; AI_PROVIDER is configured explicitly; see README for adapter-specific prerequisites and scope.
AI_PROVIDER=
# live; non-secret; AI_MODEL is configured explicitly; see README for adapter-specific prerequisites and scope.
AI_MODEL=
# live; secret; server only; OPENAI_API_KEY is configured explicitly; see README for adapter-specific prerequisites and scope.
OPENAI_API_KEY=
# live; secret; server only; ANTHROPIC_API_KEY is configured explicitly; see README for adapter-specific prerequisites and scope.
ANTHROPIC_API_KEY=
# live; non-secret; AI_EMBEDDING_MODEL is configured explicitly; see README for adapter-specific prerequisites and scope.
AI_EMBEDDING_MODEL=
# live; non-secret; RUN_LIVE_AI is configured explicitly; see README for adapter-specific prerequisites and scope.
RUN_LIVE_AI=
