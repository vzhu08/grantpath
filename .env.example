# Local single-user app. Keep one process per data directory; bind to loopback.
GRANTPATH_DATA_DIR=.local-data
# No provider needed for manual editing. Explicit live opt-in only.
RUN_LIVE_AI=false
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# No NEXT_PUBLIC secrets. No OCR, crawling, reminders, external tools or submissions.
