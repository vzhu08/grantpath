# Local single-user app. Keep one process per data directory; bind to loopback.
GRANTPATH_DATA_DIR=.local-data
# No provider needed for manual editing. Explicit live opt-in only.
RUN_LIVE_AI=false
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# No NEXT_PUBLIC secrets. No OCR, crawling, reminders, external tools or submissions.
# Roadmap 01 renderer spike; optional until proposal export integration is complete.
# Absolute installed/extracted executable; examples belong in ignored .env.local.
GRANTPATH_LIBREOFFICE_PATH=
# Windows defaults to C:\Windows\Fonts. All four actual Times New Roman TTFs are required.
GRANTPATH_FONT_DIR=
GRANTPATH_EXPORT_DIR=.local-data/exports
