{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ApiError": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "code",
            "message",
            "requestId",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "Document": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "section": {
                "type": "string"
              },
              "row": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "metadata": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "filename",
        "mimeType",
        "hash",
        "text",
        "segments",
        "metadata"
      ],
      "additionalProperties": false
    },
    "Citation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string"
        },
        "segmentId": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quote": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "documentId",
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false
    },
    "Job": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "result": {},
        "error": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "state",
        "progress",
        "attempts",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "TransformRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 100000
        },
        "operation": {
          "default": "normalize",
          "type": "string",
          "enum": [
            "normalize",
            "stats"
          ]
        }
      },
      "required": [
        "text"
      ]
    },
    "TransformResult": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "words": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "characters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "string",
          "const": "local"
        }
      },
      "required": [
        "text",
        "words",
        "characters",
        "mode"
      ],
      "additionalProperties": false
    }
  }
}
